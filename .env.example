# Generate a long random value before exposing the engine over HTTPS.
VIDEO_AGENT_API_KEY=change-me
VIDEO_AGENT_ALLOWED_ORIGINS=https://your-pages.example.com

# Local knowledge connectors. The vault stays on your machine.
VIDEO_AGENT_OBSIDIAN_VAULT=/absolute/path/to/your/obsidian-vault
VIDEO_AGENT_OBSIDIAN_MAX_FILES=6000

# Fish Speech is installed separately; model weights are not bundled here.
# Apple Silicon recommended: the MLX backend avoids slow PyTorch MPS token decoding.
FISH_SPEECH_BACKEND=auto
FISH_SPEECH_MLX_ROOT=/absolute/path/to/fish-speech-mlx
FISH_SPEECH_MLX_CLI=/absolute/path/to/fish-speech-mlx/.venv/bin/fish-speech-mlx
FISH_SPEECH_MLX_MODEL=mlx-community/fish-audio-s2-pro-bf16
FISH_SPEECH_MLX_QUANTIZE=int4
# Optional: keep the Hugging Face model cache in a known location.
FISH_SPEECH_MLX_HF_HOME=/absolute/path/to/huggingface-cache

# Fish Speech 1.5 PyTorch fallback.
FISH_SPEECH_ROOT=/absolute/path/to/fish-speech
FISH_SPEECH_PYTHON=/absolute/path/to/fish-speech/.venv/bin/python
FISH_SPEECH_CHECKPOINT=/absolute/path/to/fish-speech/checkpoints/fish-speech-1.5
FISH_SPEECH_DEVICE=mps
